<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FC_IoTEffect" Id="{dbd7e76d-7736-4f94-bdcc-3276c6607da1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION FC_IoTEffect : DUT_Effect_Monoid
