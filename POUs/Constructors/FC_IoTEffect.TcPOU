    Topic   : STRING[32];
    Message : STRING[64];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[FC_IoTEffect.Count := 1;
FC_IoTEffect.Effects[1].EType := EFF_IOT_PUB;
