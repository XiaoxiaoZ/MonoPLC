  <DUT Name="DUT_Effect" Id="{ed1b3dc0-819c-430f-bc7b-fe81dbea2af0}">
    <Declaration><![CDATA[TYPE DUT_Effect :
STRUCT
	EType    : ENUM_Effect_Type := EFF_NONE;
